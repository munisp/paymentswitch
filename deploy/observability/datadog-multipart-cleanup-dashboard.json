{
  "title": "Paymentswitch Multipart Upload Cleanup",
  "description": "Cleanup latency, throughput, retries, errors, and abandoned multipart sessions across API and worker services.",
  "layout_type": "ordered",
  "is_read_only": false,
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "production",
      "available_values": ["production", "staging", "ci"]
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Cleanup latency p95 by service",
        "type": "timeseries",
        "show_legend": true,
        "requests": [
          {
            "q": "p95:trace.cleanup.multipart.session.duration{env:$env,service:$service} by {service}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          },
          {
            "q": "p95:trace.storage.s3.abort_multipart.duration{env:$env,service:$service} by {service}",
            "display_type": "line",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "yaxis": {
          "include_zero": false,
          "scale": "linear",
          "unit": "microsecond"
        }
      },
      "layout": { "x": 0, "y": 0, "width": 6, "height": 4 }
    },
    {
      "definition": {
        "title": "Cleanup batch average duration",
        "type": "query_value",
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_cleanup_duration_seconds_sum{env:$env,service:$service}.as_rate() / sum:paymentswitch_multipart_cleanup_duration_seconds_count{env:$env,service:$service}.as_rate()",
            "aggregator": "avg",
            "conditional_formats": [
              { "comparator": ">", "value": 30, "palette": "white_on_red" },
              { "comparator": ">", "value": 10, "palette": "white_on_yellow" }
            ]
          }
        ],
        "autoscale": true,
        "precision": 2,
        "text_align": "center"
      },
      "layout": { "x": 6, "y": 0, "width": 2, "height": 4 }
    },
    {
      "definition": {
        "title": "Cleanup throughput",
        "type": "timeseries",
        "show_legend": true,
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_cleanup_claimed_total{env:$env,service:$service}.as_rate()",
            "display_type": "bars"
          },
          {
            "q": "sum:paymentswitch_multipart_cleanup_aborted_total{env:$env,service:$service}.as_rate()",
            "display_type": "bars"
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "requests" }
      },
      "layout": { "x": 8, "y": 0, "width": 4, "height": 4 }
    },
    {
      "definition": {
        "title": "Multipart initiation rate by API service",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_uploads_started_total{env:$env,service:$service}.as_rate() by {service}",
            "display_type": "line"
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "requests" }
      },
      "layout": { "x": 0, "y": 4, "width": 6, "height": 4 }
    },
    {
      "definition": {
        "title": "Cleanup error rate",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_cleanup_failures_total{env:$env,service:$service} by {reason}.as_rate()",
            "display_type": "line"
          },
          {
            "q": "sum:paymentswitch_multipart_cleanup_retries_total{env:$env,service:$service} by {reason}.as_rate()",
            "display_type": "line"
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "requests" }
      },
      "layout": { "x": 6, "y": 4, "width": 6, "height": 4 }
    },
    {
      "definition": {
        "title": "Abandoned upload backlog",
        "type": "timeseries",
        "requests": [
          {
            "q": "max:paymentswitch_multipart_uploads_abandoned{env:$env,service:$service}",
            "display_type": "area",
            "style": { "palette": "warm" }
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "byte" }
      },
      "layout": { "x": 0, "y": 8, "width": 4, "height": 4 }
    },
    {
      "definition": {
        "title": "Multipart lifecycle",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_uploads_started_total{env:$env,service:$service}.as_rate()",
            "display_type": "line"
          },
          {
            "q": "sum:paymentswitch_multipart_uploads_completed_total{env:$env,service:$service}.as_rate()",
            "display_type": "line"
          },
          {
            "q": "sum:paymentswitch_multipart_uploads_aborted_total{env:$env,service:$service}.as_rate()",
            "display_type": "line"
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "requests" }
      },
      "layout": { "x": 4, "y": 8, "width": 8, "height": 4 }
    },
    {
      "definition": {
        "title": "Draft conflicts correlated with upload load",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:paymentswitch_onboarding_draft_conflicts_total{env:$env,service:$service}.as_rate()",
            "display_type": "line"
          },
          {
            "q": "sum:paymentswitch_multipart_uploads_started_total{env:$env,service:$service}.as_rate()",
            "display_type": "line"
          }
        ],
        "yaxis": { "include_zero": true, "scale": "linear", "unit": "requests" }
      },
      "layout": { "x": 0, "y": 12, "width": 6, "height": 4 }
    },
    {
      "definition": {
        "title": "S3 abort errors by service",
        "type": "toplist",
        "requests": [
          {
            "q": "sum:paymentswitch_multipart_cleanup_failures_total{env:$env,service:$service,reason:abort_error} by {service}.as_count()"
          }
        ],
        "conditional_formats": [
          { "comparator": ">", "value": 0, "palette": "white_on_red" }
        ]
      },
      "layout": { "x": 6, "y": 12, "width": 6, "height": 4 }
    }
  ],
  "notify_list": [],
  "reflow_type": "fixed"
}
