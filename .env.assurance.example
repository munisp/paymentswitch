# Copy to .env.assurance only in an isolated non-production environment.
# Never point these values at production systems or use production accounts/data.
ASSURANCE_ENV=isolated

# Isolated TLS gateway, public SNI, certificate material, and issuing CA.
APISIX_BASE_URL=https://gateway.assurance.example:9443
APISIX_TLS_SERVER_NAME=gateway.assurance.example
TLS_CA_FILE=/absolute/path/to/isolated-ca.pem
APISIX_TLS_CERT_FILE_HOST=/absolute/path/to/isolated-gateway-cert.pem
APISIX_TLS_KEY_FILE_HOST=/absolute/path/to/isolated-gateway-key.pem

# Required deployment secrets. Generate URL-safe values with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
# URL-encode POSTGRES_PASSWORD before embedding it in these DSNs if it contains reserved URL characters.
DATABASE_URL=postgresql://payment_user:REPLACE_WITH_URL_ENCODED_ISOLATED_POSTGRES_PASSWORD@postgres:5432/payment_switch
PERMIFY_DATABASE_URI=postgres://payment_user:REPLACE_WITH_URL_ENCODED_ISOLATED_POSTGRES_PASSWORD@postgres:5432/permify?sslmode=disable
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
MOJALOOP_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
JWT_SECRET=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
GRAFANA_PASSWORD=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
APISIX_ADMIN_KEY=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
KEYCLOAK_ADMIN=isolated-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_ISOLATED_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET
KEYCLOAK_APISIX_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_API_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET

# Authoritative payment-rail, operations, monitoring, settlement, and developer configuration API.
# This external service must expose /v1/payment-rails, /v1/corridors, /v1/dfsps,
# and the scoped /v1/operations/* endpoints consumed by the portal.
OPERATIONAL_CONFIGURATION_URL=https://operations.assurance.example
OPERATIONAL_CONFIGURATION_TOKEN=REPLACE_WITH_ISOLATED_OPERATIONS_SERVICE_TOKEN

# Server-only admin dashboard Authorization Code + PKCE client. Do not expose these values as NEXT_PUBLIC_* variables.
KEYCLOAK_URL=https://gateway.assurance.example:9443/auth
ADMIN_KEYCLOAK_CLIENT_ID=payment-switch-admin-dashboard
ADMIN_KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_ADMIN_KEYCLOAK_CLIENT_SECRET
ADMIN_AUTH_REDIRECT_URI=https://admin.assurance.example/api/auth/callback
ADMIN_DASHBOARD_ALLOWED_ORIGIN=https://admin.assurance.example
ADMIN_AUTH_STATE_SECRET=REPLACE_WITH_UNIQUE_ISOLATED_HEX_SECRET

# Native mobile Authorization Code + PKCE client. The redirect URI must match
# the Android/iOS application callback scheme configured for this isolated build.
MOBILE_AUTH_REDIRECT_URI=com.paymentswitch.mobile:/oauthredirect
MOBILE_KEYCLOAK_CLIENT_ID=payment-switch-mobile

# The exact issuer in the `iss` claim—not merely the Keycloak host.
# Must agree with Keycloak KC_HOSTNAME and the OIDC discovery document.
KEYCLOAK_HOSTNAME=https://gateway.assurance.example:9443/auth
KEYCLOAK_ISSUER_URL=https://gateway.assurance.example:9443/auth/realms/payment-switch
KEYCLOAK_REALM=payment-switch
KEYCLOAK_CLIENT_ID=payment-switch-portal
KEYCLOAK_LEDGER_CLIENT_ID=payment-switch-api
KEYCLOAK_LEDGER_AUDIENCE=payment-switch-api
PORTAL_ALLOWED_ORIGIN=https://portal.assurance.example
PORTAL_REDIRECT_URI=https://portal.assurance.example/callback

# Obtain these through a real isolated Keycloak authorization-code/browser flow.
# Do not use fabricated JWTs except the explicitly invalid string in the gate.
VALID_USER_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_USER_TOKEN
VALID_NONADMIN_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_NONADMIN_TOKEN
VALID_ADMIN_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_ADMIN_TOKEN

# Optional result location.
LIVE_GATE_RESULTS_FILE=/absolute/path/to/live-identity-gate-results.txt

# Dependency recovery gate acknowledgement and real persisted fixture probes.
# Set only after the isolated stack is healthy and fixture data is durable.
ALLOW_DESTRUCTIVE_RECOVERY_TESTS=false
SETTLEMENT_READ_TRPC_PATH=/api/trpc/settlements.list
LEDGER_BALANCE_PATH=/api/v1/ledger/balance
PERMIFY_PROTECTED_TRPC_PATH=/api/trpc/transactions.list
FRAUD_SCORE_PATH=/api/v1/fraud/score
FRAUD_SCORE_REQUEST_JSON={"transaction_id":"assurance-fixture-001","amount":1000,"currency":"NGN","merchant_category":"retail","transaction_type":"purchase","channel":"api","hour_of_day":12,"day_of_week":2,"is_international":false,"customer_age_days":365,"customer_transaction_count_24h":1,"customer_avg_amount_30d":1000,"device_fingerprint":"assurance-device","ip_address":"203.0.113.10"}

# Only enable after the actual Kafka/Temporal workers and their probe endpoints
# are present in the isolated composition and fixture workflow is durable.
ENABLE_KAFKA_RECOVERY_GATE=false
KAFKA_WORKFLOW_PROBE_PATH=
ENABLE_TEMPORAL_RECOVERY_GATE=false
TEMPORAL_SERVICE_NAME=
TEMPORAL_WORKFLOW_PROBE_PATH=
DEPENDENCY_RECOVERY_RESULTS_FILE=/absolute/path/to/dependency-recovery-gate-results.txt
