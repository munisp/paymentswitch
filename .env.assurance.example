# Copy to .env.assurance only in an isolated non-production environment.
# Never point these values at production systems or use production accounts/data.
ASSURANCE_ENV=isolated

# Isolated TLS gateway and its issuing CA.
APISIX_BASE_URL=https://gateway.assurance.example
TLS_CA_FILE=/absolute/path/to/isolated-ca.pem

# Required deployment secrets. Generate unique values with:
#   openssl rand -base64 48
APISIX_ADMIN_KEY=REPLACE_WITH_ISOLATED_RANDOM_SECRET
KEYCLOAK_ADMIN=isolated-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_ISOLATED_RANDOM_SECRET
KEYCLOAK_APISIX_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_API_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET

# The exact issuer in the `iss` claim—not merely the Keycloak host.
# Must agree with Keycloak KC_HOSTNAME and the OIDC discovery document.
KEYCLOAK_HOSTNAME=https://gateway.assurance.example/auth
KEYCLOAK_ISSUER_URL=https://gateway.assurance.example/auth/realms/payment-switch
KEYCLOAK_REALM=payment-switch

# Obtain these through a real isolated Keycloak authorization-code/browser flow.
# Do not use fabricated JWTs except the explicitly invalid string in the gate.
VALID_USER_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_USER_TOKEN
VALID_NONADMIN_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_NONADMIN_TOKEN
VALID_ADMIN_BEARER_TOKEN=REPLACE_WITH_REAL_ISOLATED_ADMIN_TOKEN

# Optional result location.
LIVE_GATE_RESULTS_FILE=/absolute/path/to/live-identity-gate-results.txt

# Dependency recovery gate acknowledgement and real persisted fixture probes.
# Set only after the isolated stack is healthy and fixture data is durable.
ALLOW_DESTRUCTIVE_RECOVERY_TESTS=false
SETTLEMENT_READ_TRPC_PATH=/api/trpc/settlements.list
LEDGER_BALANCE_PATH=/api/v1/ledger/balance
PERMIFY_PROTECTED_TRPC_PATH=/api/trpc/transactions.list
FRAUD_SCORE_PATH=/api/v1/fraud/score
FRAUD_SCORE_REQUEST_JSON={"transaction_id":"assurance-fixture-001","amount":1000,"currency":"NGN","merchant_category":"retail","transaction_type":"purchase","channel":"api","hour_of_day":12,"day_of_week":2,"is_international":false,"customer_age_days":365,"customer_transaction_count_24h":1,"customer_avg_amount_30d":1000,"device_fingerprint":"assurance-device","ip_address":"203.0.113.10"}

# Only enable after the actual Kafka/Temporal workers and their probe endpoints
# are present in the isolated composition and fixture workflow is durable.
ENABLE_KAFKA_RECOVERY_GATE=false
KAFKA_WORKFLOW_PROBE_PATH=
ENABLE_TEMPORAL_RECOVERY_GATE=false
TEMPORAL_SERVICE_NAME=
TEMPORAL_WORKFLOW_PROBE_PATH=
DEPENDENCY_RECOVERY_RESULTS_FILE=/absolute/path/to/dependency-recovery-gate-results.txt
