# Copy to .env.middleware locally and pass --env-file .env.middleware to Docker Compose.
# Do not commit .env.middleware. Generate unique local-only values; production values
# are injected by External Secrets and must never use this file.
POSTGRES_USER=ndsep_user
POSTGRES_PASSWORD=replace-with-a-unique-local-postgres-password
POSTGRES_DB=ndsep_db

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-unique-local-keycloak-password

OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-unique-local-opensearch-password
MINIO_ROOT_USER=replace-with-local-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-unique-local-minio-secret
NEO4J_PASSWORD=replace-with-a-unique-local-neo4j-password

# Optional and non-production only. An empty value leaves Open Banking sandbox
# credentials unavailable rather than serving a shared embedded key.
OPEN_BANKING_SANDBOX_API_KEY=
